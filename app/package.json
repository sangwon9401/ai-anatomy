{
  "name": "gpt-classroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts",
    "build:pages": "tsc --noEmit && node scripts/build-pages.mjs",
    "og": "node scripts/og-images.mjs",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/player": "4.0.538",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
